# Local development me is file ko copy karke ".env" bana lo (ya ".env.local")
# aur apne backend ka URL daal do.
#
# Vercel pe deploy karte waqt: Project -> Settings -> Environment Variables
# me VITE_API_URL naam se ye variable add karna zaroori hai, warna frontend
# localhost pe hi call karega aur Vercel pe register/login/bill sab fail
# honge.
#
# Value hamesha backend ke URL ke aage "/api" laga ke do:
VITE_API_URL=https://your-backend-project.vercel.app/api
